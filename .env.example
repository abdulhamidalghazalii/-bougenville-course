# ============================================================
# SYAFA COURSE - ENVIRONMENT VARIABLES
# ============================================================

# Supabase Project URL (Dapatkan dari Dashboard Supabase -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Aman ditaruh di browser frontend, dilindungi oleh Row Level Security)
# JANGAN PERNAH menaruh service_role key di sini!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nama Aplikasi & Mode
VITE_APP_NAME="Syafa Course"
VITE_ENABLE_DEMO_DATA=true
